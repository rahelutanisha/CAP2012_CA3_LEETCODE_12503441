class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2){
       int n =nums1.size();
       int m=nums2.size();
       int c[2000];
       int i =0, j=0,k=0;
          while(i<n && j<m)
          {
             if(nums1[i]<nums2[j])
             {
                c[k] =nums1[i];
                i++;
             }
             else
             {
                c[k]=nums2[j];
                j++;
             }
             k++;
          }
          while (i <n)
          {
            c[k]=nums1[i];
            i++;
            k++;
          }
          while(j<m)
          {
            c[k]=nums2[j];
            j++;
            k++;
          }
    
           
           if(k%2==1)
           {
            return c[k/2];
           }
           else
           {
            return (c[k/2]+c[k/2-1])/2.0;
           }

    }
};
