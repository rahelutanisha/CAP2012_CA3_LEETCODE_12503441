class MyCircularDeque {
public:
 int arr[1000];
    int front;
    int rear;
    int capacity;
    int count;
    MyCircularDeque(int k) {
        capacity = k;
        front = 0;
        rear = -1;
        count = 0;
    }
    
    bool insertFront(int value) {
         if(isFull())
        return false;
        if(isEmpty()) {
            front = rear = 0;
        }
        else {
            front = (front - 1 + capacity) % capacity;
        }

        arr[front] = value;
        count++;
        return true;
    }

    
    
    bool insertLast(int value) {
        if(isFull())
            return false;

        if(isEmpty()) {
            front = rear = 0;
        }
        else {
            rear = (rear + 1) % capacity;
        }

        arr[rear] = value;
        count++;
        return true;
    }

    
    bool deleteFront() {
        if(isEmpty())
            return false;

        if(front == rear) {
            front = 0;
            rear = -1;
        }
        else {
            front = (front + 1) % capacity;
        }

        count--;
        return true;
    }
    
    bool deleteLast() {
       if(isEmpty())
            return false;

        if(front == rear) {
            front = 0;
            rear = -1;
        }
        else {
            rear = (rear - 1 + capacity) % capacity;
        }

        count--;
        return true; 
    }
    
    int getFront() {
        if(isEmpty())
            return -1;

        return arr[front]; 
    }
    
    int getRear() {
        if(isEmpty())
            return -1;

        return arr[rear];
    }
    
    bool isEmpty() {
      return count == 0;  
    }
    
    bool isFull() {
            return count == capacity;
    }
    
};

