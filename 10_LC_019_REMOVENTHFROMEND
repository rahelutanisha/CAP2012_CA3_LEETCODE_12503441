class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        ListNode* prev = head;
        ListNode* temp = head;
        for(int i = 0; i<n;i++)
        {
            temp = temp ->next;
        }
        if(temp == NULL)
        {
            return head->next;
        }
        while(temp->next!=NULL)
        {
            prev = prev->next;
            temp = temp->next;
        }
        prev->next = prev->next->next;
        return head;
    }
};
